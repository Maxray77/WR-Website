# ---------------------------------------------------------------------------
# Raptor Rescue and Research Inc. — environment variables
#
# Copy to .env.local for development, and set the same values in your host's
# dashboard for production. Never commit real values: this repository should
# stay private, but treat every key below as a secret regardless.
# ---------------------------------------------------------------------------

# Public base URL, no trailing slash. Used to build Stripe return URLs,
# canonical tags and the sitemap. In production this must be the live domain.
NEXT_PUBLIC_SITE_URL=https://www.raptorrescueusa.org


# --- Stripe (card donations) -----------------------------------------------
# Without this key the donate page still renders in full and the giving copy,
# DAF/stock/check routes and FAQ all work — only the card form is disabled,
# and it tells the visitor so rather than failing silently.
#
# Get it from: Stripe Dashboard -> Developers -> API keys
#   Test mode: sk_test_...    Live mode: sk_live_...
# Apply for Stripe's nonprofit rate (2.2% + 30c) at stripe.com/docs/nonprofit
STRIPE_SECRET_KEY=


# --- Contact form delivery (Resend) ----------------------------------------
# Without these the form still accepts submissions and thanks the sender, but
# nothing is delivered — the message is logged with a warning instead. Set
# them before launch.
#
# 1. Create an account at resend.com (free tier is ample)
# 2. Verify raptorrescueusa.org as a sending domain (adds SPF/DKIM DNS records)
# 3. Create an API key
RESEND_API_KEY=

# Must be an address at a domain you have verified in Resend.
CONTACT_FROM_EMAIL=Raptor Rescue Website <website@raptorrescueusa.org>

# Where contact-form messages are delivered. Defaults to the address in
# src/lib/constants.ts if unset.
CONTACT_TO_EMAIL=info@raptorrescueusa.org
