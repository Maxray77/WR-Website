# ─────────────────────────────────────────────────────────────
#  Screening Plan App — environment variables
#  Copy to .env.local for local dev; set the same keys in Vercel.
# ─────────────────────────────────────────────────────────────

# Postgres connection string.
# Vercel → Storage → Neon (Marketplace) creates DATABASE_URL automatically.
# Use the POOLED connection string (ends with -pooler...) for the app.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Public base URL — used to build booking-management links inside emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Admin access ─────────────────────────────────────────────
# Password for the /admin dashboard.
ADMIN_PASSWORD="change-me-to-something-long"
# 32+ random chars used to sign the admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ── Email (Resend) ───────────────────────────────────────────
# raptorrescue.org is already a verified Resend sending domain.
RESEND_API_KEY=""
SCREENING_FROM_EMAIL="All That Breathes Screenings <screenings@raptorrescue.org>"
SCREENING_REPLY_TO="nadeem@raptorrescue.org"
# Optional: BCC every outgoing email to an internal archive address.
SCREENING_BCC=""

# Without RESEND_API_KEY the app still works end-to-end — emails are
# logged to the server console instead of being sent.
